{
  "name": "tally-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "gen:types": "cargo run --quiet -p tally-core --features schema --example export_schema -- src/lib/generated && node scripts/gen-types.mjs",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "json-schema-to-typescript": "^16.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.7"
  }
}
