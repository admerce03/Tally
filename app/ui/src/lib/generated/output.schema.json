{
  "$defs": {
    "Assignment": {
      "properties": {
        "curves": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssignmentCurve"
          },
          "type": "array"
        },
        "due": {
          "default": null,
          "format": "date",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "points_possible": {
          "format": "double",
          "type": "number"
        },
        "score": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/AssignmentStatus",
          "default": "pending"
        }
      },
      "required": [
        "id",
        "name",
        "points_possible"
      ],
      "type": "object"
    },
    "AssignmentCurve": {
      "description": "A curve is an assumption layered on the stored score; it never mutates it.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Add N points to the score.",
          "properties": {
            "add_points": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "add_points"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Scale so `top_score` becomes full marks: score * possible / top_score.",
          "properties": {
            "scale_top_to": {
              "properties": {
                "top_score": {
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "top_score"
              ],
              "type": "object"
            }
          },
          "required": [
            "scale_top_to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Change the points possible to `new_max` (score unchanged).",
          "properties": {
            "set_max": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "set_max"
          ],
          "type": "object"
        }
      ]
    },
    "AssignmentStatus": {
      "enum": [
        "pending",
        "submitted",
        "graded",
        "missing",
        "excused"
      ],
      "type": "string"
    },
    "AssignmentView": {
      "description": "An assignment plus flags derived by core, so adapters never re-implement grade rules.",
      "properties": {
        "counts_as_graded": {
          "description": "Counted in the current grade (scored, or missing = 0; never excused).",
          "type": "boolean"
        },
        "curves": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssignmentCurve"
          },
          "type": "array"
        },
        "dropped": {
          "description": "Dropped by the category's drop-lowest rule in the current grade (curves applied).",
          "type": "boolean"
        },
        "due": {
          "default": null,
          "format": "date",
          "type": [
            "string",
            "null"
          ]
        },
        "hypothetical": {
          "description": "Added by the scenario being viewed (never true without a scenario).",
          "type": "boolean"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "points_possible": {
          "format": "double",
          "type": "number"
        },
        "remaining": {
          "description": "Unscored work that still counts as remaining (solver, leverage).",
          "type": "boolean"
        },
        "score": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/AssignmentStatus",
          "default": "pending"
        }
      },
      "required": [
        "id",
        "name",
        "points_possible",
        "remaining",
        "counts_as_graded",
        "dropped",
        "hypothetical"
      ],
      "type": "object"
    },
    "CategoryBreakdown": {
      "description": "Per-category part of the current grade.",
      "properties": {
        "average": {
          "description": "Current category average (percent) after curves and drops; `None` without graded work.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "category_id": {
          "format": "uuid",
          "type": "string"
        },
        "dropped": {
          "description": "Graded assignments dropped by drop-lowest.",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "effective_weight": {
          "description": "Share (percent 0-100) of the current grade this category carries after renormalizing\nover categories with graded work; 0 if it is excluded (no graded work, or weight 0).",
          "format": "double",
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "weight": {
          "description": "Configured weight.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "category_id",
        "name",
        "weight",
        "effective_weight",
        "dropped"
      ],
      "type": "object"
    },
    "CategoryView": {
      "properties": {
        "assignments": {
          "items": {
            "$ref": "#/$defs/AssignmentView"
          },
          "type": "array"
        },
        "drop_lowest": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "weight": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "weight",
        "drop_lowest",
        "assignments"
      ],
      "type": "object"
    },
    "CompareCourse": {
      "properties": {
        "course_id": {
          "format": "uuid",
          "type": "string"
        },
        "current": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "current_letter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Letter"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "projected": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "projected_letter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Letter"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "course_id",
        "name"
      ],
      "type": "object"
    },
    "CompareTerm": {
      "properties": {
        "gpa": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "term_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "term_id",
        "name"
      ],
      "type": "object"
    },
    "CourseCurve": {
      "properties": {
        "add_points": {
          "default": 0.0,
          "description": "Added to the final percent.",
          "format": "double",
          "type": "number"
        },
        "cutoff_shift": {
          "default": 0.0,
          "description": "Subtracted from every letter cutoff.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "CourseGpaEntry": {
      "properties": {
        "course_id": {
          "format": "uuid",
          "type": "string"
        },
        "credits": {
          "format": "double",
          "type": "number"
        },
        "exclusion": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExclusionReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "included": {
          "type": "boolean"
        },
        "letter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Letter"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "points": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "course_id",
        "name",
        "credits",
        "included"
      ],
      "type": "object"
    },
    "CourseGradeReport": {
      "properties": {
        "categories": {
          "description": "How the current grade is made up, per category (course order).",
          "items": {
            "$ref": "#/$defs/CategoryBreakdown"
          },
          "type": "array"
        },
        "course_id": {
          "format": "uuid",
          "type": "string"
        },
        "current": {
          "description": "Renormalized over categories with graded work; `None` if no graded work.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "current_letter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Letter"
            },
            {
              "type": "null"
            }
          ]
        },
        "curve_mode": {
          "$ref": "#/$defs/CurveMode"
        },
        "projected": {
          "description": "Full weights, remaining work as 0.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "projected_letter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Letter"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "course_id",
        "curve_mode",
        "categories"
      ],
      "type": "object"
    },
    "CourseSummary": {
      "properties": {
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "credits": {
          "format": "double",
          "type": "number"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "credits"
      ],
      "type": "object"
    },
    "CourseView": {
      "description": "A course with derived flags on every assignment (output of `show_course`).",
      "properties": {
        "categories": {
          "items": {
            "$ref": "#/$defs/CategoryView"
          },
          "type": "array"
        },
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "credits": {
          "format": "double",
          "type": "number"
        },
        "curve": {
          "$ref": "#/$defs/CourseCurve"
        },
        "cutoffs": {
          "$ref": "#/$defs/LetterCutoffs"
        },
        "gpa_status": {
          "$ref": "#/$defs/GpaStatus"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "official_letter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Letter"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "credits",
        "cutoffs",
        "curve",
        "gpa_status",
        "categories"
      ],
      "type": "object"
    },
    "CumulativeGpaReport": {
      "properties": {
        "credits": {
          "format": "double",
          "type": "number"
        },
        "gpa": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/TermGpaReport"
          },
          "type": "array"
        }
      },
      "required": [
        "credits",
        "terms"
      ],
      "type": "object"
    },
    "CurveMode": {
      "enum": [
        "apply",
        "ignore"
      ],
      "type": "string"
    },
    "CutoffEntry": {
      "description": "One letter's minimum percent.",
      "properties": {
        "letter": {
          "$ref": "#/$defs/Letter"
        },
        "min": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "letter",
        "min"
      ],
      "type": "object"
    },
    "EntityKind": {
      "description": "What an Add* command created.",
      "enum": [
        "term",
        "course",
        "category",
        "assignment",
        "scenario"
      ],
      "type": "string"
    },
    "ExclusionReason": {
      "enum": [
        "pass_fail",
        "withdrawn",
        "retaken",
        "zero_credits",
        "no_grade"
      ],
      "type": "string"
    },
    "GpaEntry": {
      "description": "Grade points for one letter.",
      "properties": {
        "letter": {
          "$ref": "#/$defs/Letter"
        },
        "points": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "letter",
        "points"
      ],
      "type": "object"
    },
    "GpaScale": {
      "description": "Letter to grade points (editable).",
      "properties": {
        "points": {
          "items": {
            "$ref": "#/$defs/GpaEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "points"
      ],
      "type": "object"
    },
    "GpaStatus": {
      "enum": [
        "normal",
        "pass_fail",
        "withdrawn",
        "retaken"
      ],
      "type": "string"
    },
    "ImpactEntry": {
      "properties": {
        "assignment_id": {
          "format": "uuid",
          "type": "string"
        },
        "delta": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "due": {
          "format": "date",
          "type": [
            "string",
            "null"
          ]
        },
        "grade_after": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "grade_before": {
          "description": "Running grade before this assignment was graded; `None` for the first graded work.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "assignment_id",
        "name"
      ],
      "type": "object"
    },
    "Letter": {
      "enum": [
        "A+",
        "A",
        "A-",
        "B+",
        "B",
        "B-",
        "C+",
        "C",
        "C-",
        "D+",
        "D",
        "F"
      ],
      "type": "string"
    },
    "LetterCutoffs": {
      "description": "Minimum percent for each letter. Letters without an entry are never awarded (F is the fallback).",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/CutoffEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "entries"
      ],
      "type": "object"
    },
    "LeverageEntry": {
      "properties": {
        "assignment_id": {
          "format": "uuid",
          "type": "string"
        },
        "category_id": {
          "format": "uuid",
          "type": "string"
        },
        "leverage": {
          "description": "Final-grade points gained per 10% scored on this assignment.",
          "format": "double",
          "type": "number"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "assignment_id",
        "name",
        "category_id",
        "leverage"
      ],
      "type": "object"
    },
    "LeverageReport": {
      "properties": {
        "baseline_used": {
          "format": "double",
          "type": "number"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/LeverageEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "baseline_used",
        "entries"
      ],
      "type": "object"
    },
    "Override": {
      "oneOf": [
        {
          "properties": {
            "assignment_id": {
              "format": "uuid",
              "type": "string"
            },
            "score": {
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "type": {
              "const": "set_score",
              "type": "string"
            }
          },
          "required": [
            "type",
            "assignment_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "assignment_id": {
              "format": "uuid",
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/AssignmentStatus"
            },
            "type": {
              "const": "set_status",
              "type": "string"
            }
          },
          "required": [
            "type",
            "assignment_id",
            "status"
          ],
          "type": "object"
        },
        {
          "properties": {
            "assignment": {
              "$ref": "#/$defs/Assignment"
            },
            "category_id": {
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "add_assignment",
              "type": "string"
            }
          },
          "required": [
            "type",
            "category_id",
            "assignment"
          ],
          "type": "object"
        },
        {
          "properties": {
            "assignment_id": {
              "format": "uuid",
              "type": "string"
            },
            "curves": {
              "items": {
                "$ref": "#/$defs/AssignmentCurve"
              },
              "type": "array"
            },
            "type": {
              "const": "set_assignment_curves",
              "type": "string"
            }
          },
          "required": [
            "type",
            "assignment_id",
            "curves"
          ],
          "type": "object"
        },
        {
          "properties": {
            "course_id": {
              "format": "uuid",
              "type": "string"
            },
            "curve": {
              "$ref": "#/$defs/CourseCurve"
            },
            "type": {
              "const": "set_course_curve",
              "type": "string"
            }
          },
          "required": [
            "type",
            "course_id",
            "curve"
          ],
          "type": "object"
        },
        {
          "properties": {
            "course_id": {
              "format": "uuid",
              "type": "string"
            },
            "gpa_status": {
              "$ref": "#/$defs/GpaStatus"
            },
            "type": {
              "const": "set_gpa_status",
              "type": "string"
            }
          },
          "required": [
            "type",
            "course_id",
            "gpa_status"
          ],
          "type": "object"
        },
        {
          "properties": {
            "course_id": {
              "format": "uuid",
              "type": "string"
            },
            "letter": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Letter"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "type": {
              "const": "set_official_letter",
              "type": "string"
            }
          },
          "required": [
            "type",
            "course_id"
          ],
          "type": "object"
        }
      ]
    },
    "Scenario": {
      "description": "What-if scenario: named overlay of hypothetical changes (see `scenario::apply_scenario`).",
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "overrides": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Override"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "ScenarioColumn": {
      "description": "One column of a comparison: the real data (`scenario_id: None`) or a scenario.",
      "properties": {
        "courses": {
          "items": {
            "$ref": "#/$defs/CompareCourse"
          },
          "type": "array"
        },
        "cumulative_gpa": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "error": {
          "default": null,
          "description": "Set when the scenario failed to apply; the result fields are then empty/None.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "\"real\" for the baseline, else the scenario name.",
          "type": "string"
        },
        "scenario_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/CompareTerm"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "courses",
        "terms"
      ],
      "type": "object"
    },
    "SolveResult": {
      "properties": {
        "grade_at_needed": {
          "description": "Final grade when remaining work scores `needed` (Secured: grade at 0%).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "remaining_count": {
          "description": "Ungraded, non-excused, non-locked assignments with points possible > 0.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/SolveStatus"
        },
        "target_percent": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "status",
        "target_percent",
        "remaining_count"
      ],
      "type": "object"
    },
    "SolveStatus": {
      "oneOf": [
        {
          "description": "Target is met even if all remaining work scores 0.",
          "properties": {
            "state": {
              "const": "secured",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "description": "Reachable: every remaining assignment needs `needed` percent (0-100).",
          "properties": {
            "needed": {
              "format": "double",
              "type": "number"
            },
            "state": {
              "const": "on_track",
              "type": "string"
            }
          },
          "required": [
            "state",
            "needed"
          ],
          "type": "object"
        },
        {
          "description": "Needs more than 100% (`Some`, up to the search cap).\n\n`needed: None` covers two cases: there is no remaining work to solve for, or the target\nis unreachable even at the search cap (1000%). Callers distinguish them via\n`SolveResult::remaining_count` (0 means no remaining work).",
          "properties": {
            "needed": {
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "state": {
